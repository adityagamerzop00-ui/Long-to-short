{
  "name": "Long to Shorts Clipper",
  "short_name": "Long to Shorts",
  "description": "Turn one long video into Shorts and Reels. Free, no watermark, runs on your phone.",
  "id": "./",
  "start_url": "./?source=app",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#08080f",
  "theme_color": "#08080f",
  "lang": "en-IN",
  "categories": ["photo", "video", "productivity"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [{ "name": "video", "accept": ["video/*", ".mp4", ".mov", ".webm", ".mkv"] }] }
  }
}
